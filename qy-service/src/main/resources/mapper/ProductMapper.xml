<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.liu.mapper.ProductMapper">

    <select id="pageQuery" resultType="com.liu.vo.ProductVO" parameterType="com.liu.dto.ProductPageQueryDTO">
        select * from product order by create_time desc
    </select>

    <select id="countProducts" resultType="java.lang.Long">
        select count(*) from product
    </select>
</mapper>